#include <stdio.h>

int main() {
    int n;
    scanf("%d", &n);

    int a[n][n], b[n][n];

    // Input matrix
    for(int i = 0; i < n; i++) {
        for(int j = 0; j < n; j++) {
            scanf("%d", &a[i][j]);
        }
    }

    // Rotate 90 degree clockwise
    for(int i = 0; i < n; i++) {
        for(int j = 0; j < n; j++) {
            b[j][n - 1 - i] = a[i][j];
        }
    }

    // Print rotated matrix
    for(int i = 0; i < n; i++) {
        for(int j = 0; j < n; j++) {
            printf("%d ", b[i][j]);
        }
        printf("\n");
    }

    return 0;
}
